{
  "listen": "127.0.0.1:18181",
  "providers": [
    {
      "id": "codex",
      "type": "codex-app-server",
      "prefix": "codex",
      "enabled": true,
      "models": ["gpt-5.6-luna", "gpt-5.6-terra", "gpt-5.6-sol"],
      "model_metadata": {
        "gpt-5.6-luna": {
          "context_length": 128000,
          "max_output_tokens": 128000
        },
        "gpt-5.6-terra": {
          "context_length": 258400,
          "max_output_tokens": 128000
        },
        "gpt-5.6-sol": {
          "context_length": 258400,
          "max_output_tokens": 128000
        }
      },
      "codex": {
        "command": "codex",
        "args": ["app-server", "--listen", "stdio://"],
        "model": "gpt-5.6-luna",
        "working_directory": ".",
        "sandbox": "read-only",
        "approval_policy": "never",
        "ephemeral": true,
        "experimental_api": true
      }
    },
    {
      "id": "openrouter",
      "type": "openrouter",
      "prefix": "openrouter",
      "enabled": false,
      "api_key_env": "OPENROUTER_API_KEY",
      "headers": {
        "HTTP-Referer": "https://example.local",
        "X-OpenRouter-Title": "llm-provider",
        "X-OpenRouter-Cache": "true",
        "X-OpenRouter-Cache-TTL": "600"
      }
    },
    {
      "id": "claude",
      "type": "anthropic",
      "prefix": "claude",
      "enabled": false,
      "api_key_env": "CLAUDE_API_KEY",
      "model_metadata": {
        "claude-sonnet-5": {
          "context_length": 1000000,
          "max_output_tokens": 128000
        }
      }
    },
    {
      "id": "local",
      "type": "openai-compatible",
      "prefix": "local",
      "enabled": true,
      "base_url": "http://macmini:11888/v1"
    },
    {
      "id": "grok",
      "type": "openai-compatible",
      "prefix": "grok",
      "enabled": false,
      "base_url": "https://api.x.ai/v1",
      "api_key_env": "XAI_API_KEY"
    }
  ]
}
